<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深青绿渐变底，左上偏暗、右下偏亮 -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#0B4237"
                android:endColor="#268F73" />
        </aapt:attr>
    </path>

    <!-- 两枚很淡的光斑，让纯色背景有层次 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.075"
        android:pathData="M88,14 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.05"
        android:pathData="M12,98 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0" />
</vector>
